\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Packaging and in-vessel deployment of the AlGaN/GaN Hall-effect sensor in HSX. The sensor die was wire-bonded to a ceramic leadless chip carrier, epoxy-coated, and mounted on a custom flange for insertion into the HSX vessel near the plasma edge.}}{2}{}\protected@file@percent }
\newlabel{fig:pkg}{{2}{2}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Experimental readout configuration for the in-vessel Hall-effect sensor. The sensor was voltage-biased using the built-in waveform generator of an oscilloscope, and the transverse Hall voltage was amplified using a differential readout chain before data acquisition.}}{2}{}\protected@file@percent }
\newlabel{fig:readout}{{3}{2}{}{figure.3}{}}
